---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { client, urlFor } from "../../lib/sanity"
import { projectsQuery } from "../../lib/queries"

const staticProjects = [
  { title: 'Dramée', category: ['Web Development'], slug: { current: 'dramee' }, coverImage: null },
  { title: 'Lustra', category: ['E-commerce'], slug: { current: 'lustra' }, coverImage: null },
  { title: 'Chalet Ciro', category: ['Branding', 'Web'], slug: { current: 'chalet-ciro' }, coverImage: null },
  { title: 'Le Angioine', category: ['Web Design'], slug: { current: 'le-angioine' }, coverImage: null },
]

const fetchedProjects = await client.fetch(projectsQuery).catch(() => [])
const projects = fetchedProjects.length > 0 ? fetchedProjects : staticProjects

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "url": "https://traccestudio.it/portfolio",
      "name": "Portfolio — Tracce Studio",
      "description": "Scopri i progetti di Tracce Studio: siti web, brand identity ed e-commerce realizzati in Campania e in tutta Italia.",
      "isPartOf": { "@type": "WebSite", "url": "https://traccestudio.it" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://traccestudio.it/" },
        { "@type": "ListItem", "position": 2, "name": "Portfolio", "item": "https://traccestudio.it/portfolio" }
      ]
    }
  ]
}
---
<BaseLayout title="Portfolio — Tracce Studio" description="Scopri i progetti di Tracce Studio: siti web, brand identity ed e-commerce realizzati per clienti in Campania e in tutta Italia." pageSchema={pageSchema}>

  <section class="ts-container" style="padding-top:80px; padding-bottom:40px;">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:24px;">— I nostri lavori</p>
    <h1 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(48px,7vw,80px); line-height:0.92; color:#0a0a0a;">
      Portfolio
    </h1>
  </section>

  <section class="ts-container" style="padding-bottom:80px;">
    <div class="ts-portfolio-grid-2">
      {projects.map((p: any) => (
        <a href={"/portfolio/" + p.slug?.current} class="gsap-portfolio-card" style="position:relative; overflow:hidden; background:#161616; display:block; text-decoration:none; aspect-ratio:4/3;">
          {p.coverImage ? (
            <img src={urlFor(p.coverImage).width(800).url()} alt={p.title} loading="lazy" style="width:100%; height:100%; object-fit:cover; display:block; transition:transform 0.4s;" />
          ) : (
            <div style="width:100%; height:100%; background:#1a1a1a; display:flex; align-items:center; justify-content:center;">
              <span style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:40px; color:rgba(255,255,255,0.05); text-transform:uppercase;">{p.title}</span>
            </div>
          )}
          <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 55%); display:flex; flex-direction:column; justify-content:flex-end; padding:24px;">
            <p style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:24px; color:#fff; letter-spacing:0.04em; margin-bottom:4px;">{p.title}</p>
            {p.category && <p style="font-size:12px; color:rgba(255,255,255,0.6);">{p.category.join(" · ")}</p>}
          </div>
        </a>
      ))}
    </div>
  </section>

</BaseLayout>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  document.addEventListener('astro:page-load', () => {
    const cards = gsap.utils.toArray<HTMLElement>('.gsap-portfolio-card')
    if (!cards.length) return
    gsap.from(cards, {
      scrollTrigger: { trigger: cards[0], start: 'top 88%', once: true },
      y: 60, opacity: 0, duration: 0.85, stagger: 0.1, ease: 'power3.out'
    })
  })
</script>