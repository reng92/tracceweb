---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { client } from '../../lib/sanity'
import { urlFor } from '../../lib/sanity'

export async function getStaticPaths() {
  const projects = await client.fetch(
    `*[_type == "project"]{ slug, title, category, description, url, coverImage, gallery, clientLogo, tags, desktopImage, mobileImages }`
  ).catch(() => [])

  if (projects.length === 0) {
    return [
      { params: { slug: 'dramee' }, props: { project: { title: 'Dramée', category: 'Web Development', description: 'Progetto in arrivo.', url: null, coverImage: null, gallery: [], clientLogo: null, tags: ['Web Development', 'UI Design'], desktopImage: null, mobileImages: [] } } },
      { params: { slug: 'lustra' }, props: { project: { title: 'Lustra', category: 'E-commerce', description: 'Progetto in arrivo.', url: null, coverImage: null, gallery: [], clientLogo: null, tags: ['E-commerce', 'Shopify'], desktopImage: null, mobileImages: [] } } },
      { params: { slug: 'chalet-ciro' }, props: { project: { title: 'Chalet Ciro', category: 'Branding + Web', description: 'Progetto in arrivo.', url: null, coverImage: null, gallery: [], clientLogo: null, tags: ['Branding', 'Web Development'], desktopImage: null, mobileImages: [] } } },
    ]
  }

  return projects.map((p: any) => ({
    params: { slug: p.slug.current },
    props: { project: p },
  }))
}

const { project } = Astro.props
const p = project
---

<BaseLayout title={project.title + ' — Tracce Studio'} description={project.description ? project.description.slice(0, 155) + (project.description.length > 155 ? '…' : '') : `Scopri il progetto ${project.title} realizzato da Tracce Studio: web design e sviluppo su misura in Campania.`}>

  <!-- HERO PROGETTO -->
  <section style="padding: 80px 48px 60px; border-bottom: 1px solid rgba(0,0,0,0.08);">
    <a href="/portfolio" style="font-size:11px; letter-spacing:0.12em; text-transform:uppercase; color:#0033ff; text-decoration:none; font-weight:500;">
      ← Portfolio
    </a>
    <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-top:32px; flex-wrap:wrap; gap:24px;">
      <div>
        {project.clientLogo && (
          <img src={urlFor(project.clientLogo).height(48).url()} alt={project.title} style="height:40px; margin-bottom:20px; display:block;" />
        )}
        <h1 id="slug-title" style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(48px,7vw,88px); line-height:1; color:#0a0a0a; margin:0;">
          {project.title}
        </h1>
        <p style="font-size:12px; letter-spacing:0.1em; text-transform:uppercase; color:#888; margin-top:12px;">
          {project.category}
        </p>
      </div>
      {project.url && (
        <a href={project.url} target="_blank" rel="noopener" data-gsap="magnetic" style="background:#0033ff; color:#fff; font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:13px; letter-spacing:0.12em; text-transform:uppercase; padding:14px 32px; border-radius:2px; text-decoration:none; white-space:nowrap;">
          Visita il sito →
        </a>
      )}
    </div>
  </section>

  <!-- IMMAGINE COVER -->
  {project.coverImage && (
    <section style="padding: 0 48px;">
      <img
        src={urlFor(project.coverImage).width(1600).quality(90).url()}
        alt={project.title}
        loading="lazy"
        style="width:100%; max-height:600px; object-fit:cover; display:block; border-radius:2px;"
      />
    </section>
  )}

  <!-- DESCRIZIONE + TAG -->
  <section style="padding: 60px 48px; display:grid; grid-template-columns:1fr 300px; gap:60px; border-bottom:1px solid rgba(0,0,0,0.08);">
    <div>
      <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:16px;">Il progetto</p>
      <p data-gsap="fade" style="font-size:16px; line-height:1.8; color:#333; max-width:640px;">
        {project.description}
      </p>
    </div>
    <div>
      <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#888; font-weight:500; margin-bottom:16px;">Servizi</p>
      <div style="display:flex; flex-direction:column; gap:8px;">
        {(project.tags ?? []).map((tag: string) => (
          <span style="font-size:12px; font-weight:500; color:#0a0a0a; padding:8px 0; border-bottom:1px solid rgba(0,0,0,0.08);">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- MOCKUP LAPTOP DESKTOP -->
  {p.desktopImage && (
    <section class="mockup-desktop-section" data-gsap="fade">
      <div class="laptop">
        <div class="lp-lid">
          <div class="lp-bezel-top">
            <div class="lp-camera"><span></span></div>
          </div>
          <div class="lp-screen">
            <img
              src={urlFor(p.desktopImage).width(1600).quality(90).url()}
              alt={p.title + ' — desktop'}
              loading="lazy"
            />
          </div>
          <div class="lp-bezel-bottom"></div>
        </div>
        <div class="lp-hinge"></div>
        <div class="lp-base">
          <div class="lp-kbd-area">
            <div class="lp-kbd"></div>
          </div>
          <div class="lp-touchpad"></div>
        </div>
        <div class="lp-bottom-edge"></div>
      </div>
    </section>
  )}

  <!-- MOCKUP SMARTPHONE MOBILE -->
  {p.mobileImages && p.mobileImages.length > 0 && (
    <section class="mockup-mobile-section" data-gsap="fade">
      <div class="phones-grid">
        {p.mobileImages.slice(0, 3).map((img: any) => (
          <div class="phone">
            <div class="phone-silent"></div>
            <div class="phone-vol-up"></div>
            <div class="phone-vol-down"></div>
            <div class="phone-power"></div>
            <div class="phone-screen">
              <div class="phone-camera-dot"></div>
              <img
                src={urlFor(img).width(500).quality(85).url()}
                alt={p.title + ' — mobile'}
                loading="lazy"
              />
              <div class="phone-home-bar"></div>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- CTA PROSSIMO PROGETTO -->
  <section style="background:#0a0a0a; padding:80px 48px; text-align:center;">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:16px;">Lavoriamo insieme?</p>
    <h2 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(36px,5vw,64px); color:#fff; margin:0 0 32px;">
      Inizia il tuo progetto
    </h2>
    <a href="/contatti" data-gsap="magnetic" style="background:#0033ff; color:#fff; font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:13px; letter-spacing:0.12em; text-transform:uppercase; padding:16px 40px; border-radius:2px; text-decoration:none;">
      Contattaci →
    </a>
  </section>

</BaseLayout>

<script>
  import { gsap } from 'gsap'

  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('slug-title')) return
    gsap.from('#slug-title', { y: 60, opacity: 0, duration: 1.1, ease: 'power4.out', delay: 0.05 })
  })
</script>

<style>
  /* ---- SEZIONI ---- */
  .mockup-desktop-section {
    padding: 60px 48px 40px;
    background: #f5f4f0;
  }
  .mockup-mobile-section {
    padding: 40px 48px 80px;
    background: #f5f4f0;
  }

  /* ---- LAPTOP ---- */
  .laptop {
    max-width: 860px;
    margin: 0 auto;
    filter: drop-shadow(0 40px 80px rgba(0,0,0,0.2)) drop-shadow(0 8px 20px rgba(0,0,0,0.12));
  }

  .lp-lid {
    background: #2a2a2e;
    border-radius: 10px 10px 2px 2px;
    padding: 0;
    position: relative;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);
  }

  .lp-bezel-top {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 22px;
    background: #252528;
    border-radius: 10px 10px 0 0;
  }
  .lp-camera {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lp-camera span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #1a1a1c;
    box-shadow: inset 0 0 0 2px rgba(255,255,255,0.08), 0 0 0 1px rgba(255,255,255,0.04);
  }

  .lp-screen {
    background: #000;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    line-height: 0;
    margin: 0 12px;
  }
  .lp-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .lp-bezel-bottom {
    height: 14px;
    background: #252528;
    border-radius: 0 0 2px 2px;
  }

  .lp-hinge {
    height: 6px;
    background: linear-gradient(to bottom, #1a1a1c, #444448);
  }

  .lp-base {
    background: linear-gradient(170deg, #e0e0e2 0%, #cecece 60%, #c4c4c6 100%);
    border-radius: 0 0 8px 8px;
    padding: 18px 28px 20px;
  }
  .lp-kbd-area {
    margin-bottom: 10px;
  }
  .lp-kbd {
    height: 72px;
    border-radius: 3px;
    background-color: #c8c8ca;
    background-image:
      repeating-linear-gradient(
        0deg,
        transparent 0px, transparent 11px,
        rgba(0,0,0,0.06) 11px, rgba(0,0,0,0.06) 13px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0px, transparent 22px,
        rgba(0,0,0,0.04) 22px, rgba(0,0,0,0.04) 23px
      );
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.08);
  }
  .lp-touchpad {
    width: 26%;
    height: 44px;
    background: linear-gradient(to bottom, #d0d0d2, #c4c4c6);
    border-radius: 4px;
    margin: 0 auto;
    border: 1px solid rgba(0,0,0,0.1);
  }
  .lp-bottom-edge {
    height: 4px;
    background: linear-gradient(to bottom, #b8b8ba, #c0c0c2);
    border-radius: 0 0 6px 6px;
  }

  /* ---- SMARTPHONE (no hole) ---- */
  .phones-grid {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .phone {
    position: relative;
    width: 188px;
    background: linear-gradient(155deg, #6a6a70 0%, #46464a 45%, #5a5a5e 100%);
    border-radius: 36px;
    padding: 16px 10px;
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.1),
      0 0 0 1px rgba(0,0,0,0.65),
      0 30px 80px rgba(0,0,0,0.32),
      0 8px 20px rgba(0,0,0,0.18);
    flex-shrink: 0;
  }

  .phone-silent {
    position: absolute;
    left: -3px; top: 72px;
    width: 3px; height: 24px;
    background: #38383c;
    border-radius: 2px 0 0 2px;
  }
  .phone-vol-up {
    position: absolute;
    left: -3px; top: 110px;
    width: 3px; height: 38px;
    background: #38383c;
    border-radius: 2px 0 0 2px;
  }
  .phone-vol-down {
    position: absolute;
    left: -3px; top: 158px;
    width: 3px; height: 38px;
    background: #38383c;
    border-radius: 2px 0 0 2px;
  }
  .phone-power {
    position: absolute;
    right: -3px; top: 120px;
    width: 3px; height: 52px;
    background: #38383c;
    border-radius: 0 2px 2px 0;
  }

  .phone-screen {
    background: #000;
    border-radius: 26px;
    overflow: hidden;
    aspect-ratio: 9 / 19.5;
    position: relative;
    line-height: 0;
  }
  .phone-camera-dot {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: 9px;
    height: 9px;
    background: #111;
    border-radius: 50%;
    z-index: 2;
    box-shadow: inset 0 0 0 2px rgba(255,255,255,0.06), 0 0 0 1px rgba(255,255,255,0.04);
  }
  .phone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    padding-top: 30px;
    box-sizing: border-box;
  }
  .phone-home-bar {
    position: absolute;
    bottom: 9px;
    left: 50%;
    transform: translateX(-50%);
    width: 72px;
    height: 4px;
    background: rgba(255,255,255,0.25);
    border-radius: 2px;
    z-index: 2;
  }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 768px) {
    .mockup-desktop-section,
    .mockup-mobile-section {
      padding-left: 20px;
      padding-right: 20px;
    }
    .phone {
      width: 152px;
      border-radius: 30px;
      padding: 13px 9px;
    }
    .phone-silent   { top: 58px;  height: 20px; }
    .phone-vol-up   { top: 90px;  height: 32px; }
    .phone-vol-down { top: 132px; height: 32px; }
    .phone-power    { top: 98px;  height: 44px; }
    .phone-screen   { border-radius: 22px; }
    .phone-camera-dot { width: 7px; height: 7px; top: 11px; }
    .phone-screen img { padding-top: 24px; }
    .phones-grid    { gap: 16px; }
  }

  @media (max-width: 520px) {
    .phone {
      width: 118px;
      border-radius: 24px;
      padding: 10px 8px;
    }
    .phone-silent   { top: 45px;  height: 16px; }
    .phone-vol-up   { top: 70px;  height: 26px; }
    .phone-vol-down { top: 103px; height: 26px; }
    .phone-power    { top: 76px;  height: 36px; }
    .phone-screen   { border-radius: 17px; }
    .phone-camera-dot { width: 6px; height: 6px; top: 9px; }
    .phone-screen img { padding-top: 20px; }
    .phones-grid    { gap: 10px; }
    .phone-home-bar { width: 52px; }
  }
</style>