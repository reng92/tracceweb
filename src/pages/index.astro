        <p class="ts-service-desc" style="font-size:13px; line-height:1.7; color:#555; padding-top:4px;">{s.shortDesc || s.desc}</p>
      </div>
    ))}
  </section>

  <section style="background:#0a0a0a; padding:80px 48px;">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:32px;">— Portfolio</p>
    <div class="ts-portfolio-grid">
      {showProjects.map((p: any, i: number) => (
        
          href={"/portfolio/" + p.slug.current}
          class={i === 0 ? "ts-wide" : ""}
          style={i === 0
            ? "grid-column:span 2; position:relative; overflow:hidden; background:#161616; display:block; text-decoration:none;"
            : "position:relative; overflow:hidden; background:#161616; display:block; text-decoration:none;"}
        >
          <div style={i === 0 ? "aspect-ratio:2/1; overflow:hidden;" : "aspect-ratio:1/1; overflow:hidden;"}>
            {p.coverImage ? (
              <img src={urlFor(p.coverImage).width(900).url()} alt={p.title} style="width:100%; height:100%; object-fit:cover; display:block;" />
            ) : (
              <div style="width:100%; height:100%; background:#1a1a1a; display:flex; align-items:center; justify-content:center;">
                <span style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:40px; color:rgba(255,255,255,0.05); text-transform:uppercase;">{p.title}</span>
              </div>
            )}
          </div>
          <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 55%); display:flex; flex-direction:column; justify-content:flex-end; padding:20px;">
            <p style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:22px; color:#fff; letter-spacing:0.04em;">{p.title}</p>
            {p.category && <p style="font-size:11px; color:rgba(255,255,255,0.6); margin-top:4px;">{p.category.join(" · ")}</p>}
          </div>
        </a>
      ))}
    </div>
    <div style="margin-top:40px; text-align:center;">
      <a href="/portfolio" style="display:inline-block; border:1px solid rgba(255,255,255,0.2); color:#fff; font-family:'Barlow Condensed',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; font-size:12px; padding:14px 32px; border-radius:2px; text-decoration:none;">
        Vedi tutto il portfolio
      </a>
    </div>
  </section>

  <section style="background:#0a0a0a; padding:40px 0 60px; border-top:1px solid #1a1a1a;">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#444; font-weight:500; margin-bottom:32px; text-align:center;">Hanno scelto Tracce</p>
    <div style="overflow:hidden;">
      <div style="display:inline-flex; align-items:center; gap:64px; animation:logosTicker 25s linear infinite;">
        {["chaletciro.png","casasurace.png","leangioine.png","fbibaits.png","dramee.svg","lustra.png","bitar.png","dcn.svg","sagrasurace.png",
          "chaletciro.png","casasurace.png","leangioine.png","fbibaits.png","dramee.svg","lustra.png","bitar.png","dcn.svg","sagrasurace.png"].map((logo) => (
          <img src={"/logos/" + logo} alt={logo} style="height:32px; width:auto; object-fit:contain; filter:grayscale(1) brightness(2) opacity(0.4);" />
        ))}
      </div>
    </div>
  </section>

  <section class="ts-container" style="padding-top:80px; padding-bottom:80px; border-top:1px solid rgba(0,0,0,0.08);">
    <div class="ts-grid-2">
      <div>
        <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:24px;">— Contatti</p>
        <h2 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; line-height:0.95; font-size:clamp(36px,4.5vw,60px); margin-bottom:16px;">Dai inizio<br />al tuo progetto</h2>
        <p style="font-size:13px; color:#555; line-height:1.7; margin-bottom:40px;">
          Siamo pronti ad ascoltarti. Compila il modulo e ti ricontattiamo entro 24 ore.
        </p>
        <div style="display:flex; flex-direction:column; gap:14px;">
          <div style="display:flex; gap:14px; font-size:13px;">
            <span style="font-size:9.5px; letter-spacing:0.1em; text-transform:uppercase; font-weight:500; color:#888; min-width:58px; padding-top:2px;">Email</span>
            <span>info@traccestudio.it</span>
          </div>
          <div style="display:flex; gap:14px; font-size:13px;">
            <span style="font-size:9.5px; letter-spacing:0.1em; text-transform:uppercase; font-weight:500; color:#888; min-width:58px; padding-top:2px;">Tel</span>
            <span>+39 392 078 5890</span>
