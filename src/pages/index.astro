          Inizia il progetto
        </a>
      </div>
      <div class="ts-hero-badge" style="width:128px; height:128px; border-radius:50%; border:1.5px solid #0a0a0a; display:flex; flex-direction:column; align-items:center; justify-content:center; flex-shrink:0; margin-top:8px; gap:4px;">
        <span style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:38px; line-height:1;">TA</span>
        <span style="font-size:6.5px; letter-spacing:0.14em; text-transform:uppercase; text-align:center; color:#555; line-height:1.4;">We know how to<br />improve your<br />business</span>
      </div>
    </div>
  </section>

  <div style="background:#0033ff; padding:11px 0; overflow:hidden; white-space:nowrap;">
    <div style="display:inline-flex; animation:ticker 20s linear infinite;">
      {ticker.map((item) => (
        <span style="font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:#fff; padding:0 28px; display:inline-flex; align-items:center; gap:28px;">
          {item}<span style="width:3px; height:3px; background:rgba(255,255,255,0.4); border-radius:50%; display:inline-block;"></span>
        </span>
      ))}
    </div>
  </div>

  <section class="ts-container" style="padding-top:80px; padding-bottom:80px; border-top:1px solid rgba(0,0,0,0.08);">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:40px;">— Cosa facciamo per te</p>
    {showServices.map((s: any) => (
      <div class="ts-grid-services" style="padding:28px 0; border-top:1px solid rgba(0,0,0,0.08); align-items:start;">
        <span style="font-family:'Barlow Condensed',sans-serif; font-size:12px; font-weight:700; color:#0033ff; letter-spacing:0.08em; padding-top:4px;">{s.n}</span>
