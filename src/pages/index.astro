---
import BaseLayout from '../layouts/BaseLayout.astro'
import { client } from '../lib/sanity'
import { urlFor } from '../lib/sanity'
import { projectsQuery, servicesQuery } from '../lib/queries'

const projects = await client.fetch(projectsQuery).catch(() => [])
const services = await client.fetch(servicesQuery).catch(() => [])

const staticProjects = [
  { title: 'Dramée', category: 'Web Development', slug: { current: 'dramee' }, coverImage: null },
  { title: 'Lustra', category: 'E-commerce', slug: { current: 'lustra' }, coverImage: null },
  { title: 'Chalet Ciro', category: 'Branding + Web', slug: { current: 'chalet-ciro' }, coverImage: null },
  { title: 'Le Angioine', category: 'Web Design', slug: { current: 'le-angioine' }, coverImage: null },
]

const staticServices = [
  { n: '01', title: 'Branding', desc: 'Costruiamo identità visive memorabili.' },
  { n: '02', title: 'Web Design', desc: 'Design su misura, orientato alla conversione.' },
  { n: '03', title: 'UX/UI Design', desc: 'Interfacce intuitive e piacevoli da usare.' },
  { n: '04', title: 'Web Development', desc: 'Siti e applicazioni veloci, sicuri e scalabili.' },
  { n: '05', title: 'Digital Strategy', desc: 'Strategie data-driven per crescere online.' },
  { n: '06', title: 'Social Media', desc: 'Gestione e crescita della tua community.' },
]

const list = projects.length > 0 ? projects : staticProjects
const svcList = services.length > 0 ? services : staticServices
---
<BaseLayout title="Tracce Studio — Web Agency Campania">

  <!-- HERO -->
  <section id="hero-section" style="padding:80px 48px 60px; display:grid; grid-template-columns:1fr 140px; gap:40px; align-items:start; position:relative; overflow:hidden;">
    <div style="position:absolute; top:-80px; right:-80px; width:420px; height:420px; background:#0033ff; border-radius:50%; opacity:0.08; pointer-events:none;"></div>
    <div>
      <h1 id="hero-title" style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(52px,7.5vw,88px); line-height:1; color:#0a0a0a; margin:0;">
        La web agency<br/>
        <span style="color:#0033ff;">che ti posiziona</span><br/>
        nel mondo<br/>digitale
      </h1>
      <p id="hero-desc" style="font-size:14px; line-height:1.7; color:#555; max-width:520px; margin-top:24px;">
        Distinguiti, fatti amare e, soprattutto, fa in modo che ti seguano. Siamo una web agency con sede in Campania. Insieme trasformiamo le tue idee in un progetto <strong>a tua misura</strong>.
      </p>
      <a href="/contatti" id="hero-cta" data-gsap="magnetic" style="display:inline-block; margin-top:32px; background:#0033ff; color:#fff; font-family:'Barlow Condensed',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; font-size:13px; padding:14px 32px; border-radius:2px; text-decoration:none;">
        Inizia il progetto
      </a>
    </div>
    <div id="hero-badge" style="width:128px; height:128px; border-radius:50%; border:1px solid #0a0a0a; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; flex-shrink:0; margin-top:8px;">
      <span style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:38px; line-height:1; color:#0a0a0a;">TA</span>
      <span style="font-size:6.5px; letter-spacing:0.14em; text-transform:uppercase; text-align:center; color:#555; line-height:1.4;">We know how to<br/>improve your<br/>business</span>
    </div>
  </section>

  <!-- TICKER -->
  <div style="background:#0033ff; padding:12px 0; overflow:hidden; white-space:nowrap;">
    <div style="display:inline-flex; animation:ticker 20s linear infinite;">
      {['Branding','Web Design','UX UI Design','Web Development','Digital Strategy','Social Media','Branding','Web Design','UX UI Design','Web Development','Digital Strategy','Social Media'].map(item => (
        <span style="font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:12px; letter-spacing:0.12em; text-transform:uppercase; color:#fff; padding:0 28px; display:inline-flex; align-items:center; gap:28px;">
          {item}<span style="width:3px; height:3px; background:rgba(255,255,255,0.4); border-radius:50%; display:inline-block;"></span>
        </span>
      ))}
    </div>
  </div>

  <!-- SERVIZI -->
  <section id="gsap-services" style="padding:80px 48px; border-top:1px solid rgba(0,0,0,0.08);">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:40px;">Cosa facciamo per te</p>
    {svcList.map((s: any) => (
      <div class="gsap-service-row" style="display:grid; grid-template-columns:64px 1fr 1fr; gap:16px; padding:28px 0; border-top:1px solid rgba(0,0,0,0.08); align-items:start;">
        <span style="font-family:'Barlow Condensed',sans-serif; font-weight:700; font-size:12px; color:#0033ff; letter-spacing:0.1em; padding-top:4px;">{s.n || s.order || ''}</span>
        <h3 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:30px; line-height:1; color:#0a0a0a; margin:0;">{s.title}</h3>
        <p style="font-size:13px; line-height:1.7; color:#555; margin:0; padding-top:4px;">{s.desc || s.shortDesc}</p>
      </div>
    ))}
  </section>

  <!-- PORTFOLIO -->
  <section style="background:#0a0a0a; padding:80px 48px;">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:32px;">Portfolio</p>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:2px;">
      {list.slice(0,6).map((p: any) => (
        <a href={['/portfolio/', p.slug ? p.slug.current : ''].join('')} class="proj-card">
          {p.coverImage ? (
            <img src={urlFor(p.coverImage).width(600).url()} alt={p.title} loading="lazy" style="width:100%; height:100%; object-fit:cover; display:block;" />
          ) : (
            <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#111;">
              <span style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:40px; color:rgba(255,255,255,0.07); text-transform:uppercase;">{p.title}</span>
            </div>
          )}
          <div class="proj-overlay">
            <p class="proj-title">{p.title}</p>
            <p class="proj-cat">{p.category}</p>
          </div>
        </a>
      ))}
    </div>
    <div style="text-align:center; margin-top:40px;">
      <a href="/portfolio" data-gsap="magnetic" style="display:inline-block; border:1px solid rgba(255,255,255,0.2); color:#fff; font-family:'Barlow Condensed',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; font-size:12px; padding:14px 32px; border-radius:2px; text-decoration:none;">
        Vedi tutto il portfolio
      </a>
    </div>
  </section>

  <!-- CLIENTI -->
  <section style="background:#0a0a0a; padding:60px 48px; border-top:1px solid rgba(255,255,255,0.06);">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:40px; text-align:center;">Hanno scelto Tracce</p>
    <div style="overflow:hidden;">
      <div class="logos-ticker">
        {[
          { src: '/logos/chaletciro.png', alt: 'Chalet Ciro' },
          { src: '/logos/casasurace.png', alt: 'Casa Surace' },
          { src: '/logos/leangioine.png', alt: 'Le Angioine' },
          { src: '/logos/fbibaits.png', alt: 'FBI Baits' },
          { src: '/logos/dramee.svg', alt: 'Dramée' },
          { src: '/logos/lustra.png', alt: 'Lustra' },
          { src: '/logos/bitar.png', alt: 'Bitar' },
          { src: '/logos/dcn.svg', alt: 'DCN' },
          { src: '/logos/sagrasurace.png', alt: 'Sagra Surace' },
          { src: '/logos/chaletciro.png', alt: 'Chalet Ciro' },
          { src: '/logos/casasurace.png', alt: 'Casa Surace' },
          { src: '/logos/leangioine.png', alt: 'Le Angioine' },
          { src: '/logos/fbibaits.png', alt: 'FBI Baits' },
          { src: '/logos/dramee.svg', alt: 'Dramée' },
          { src: '/logos/lustra.png', alt: 'Lustra' },
          { src: '/logos/bitar.png', alt: 'Bitar' },
          { src: '/logos/dcn.svg', alt: 'DCN' },
          { src: '/logos/sagrasurace.png', alt: 'Sagra Surace' },
        ].map(logo => (
          <img src={logo.src} alt={logo.alt} style="height:36px; object-fit:contain; filter:grayscale(1) opacity(0.6); transition:filter 0.3s;" onmouseover="this.style.filter='grayscale(0) opacity(1) brightness(1.2)'" onmouseout="this.style.filter='grayscale(1) opacity(0.6)'" />
        ))}
      </div>
    </div>
  </section>

  <!-- CONTATTI CTA -->
  <section style="padding:80px 48px; border-top:1px solid rgba(0,0,0,0.08);">
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:80px;">
      <div>
        <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:24px;">Contatti</p>
        <h2 data-gsap="fade" style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(36px,4.5vw,60px); line-height:1; color:#0a0a0a; margin:0 0 16px;">
          Dai inizio<br/>al tuo progetto
        </h2>
        <p style="font-size:13px; color:#555; line-height:1.7; margin-bottom:32px;">Siamo pronti ad ascoltarti. Compila il modulo o contattaci entro 24 ore.</p>
        <div style="display:flex; flex-direction:column; gap:12px;">
          <div style="display:flex; gap:16px; font-size:13px;">
            <span style="font-size:9.5px; letter-spacing:0.1em; text-transform:uppercase; font-weight:500; color:#888; min-width:58px; padding-top:2px;">Email</span>
            <span>info@traccestudio.it</span>
          </div>
          <div style="display:flex; gap:16px; font-size:13px;">
            <span style="font-size:9.5px; letter-spacing:0.1em; text-transform:uppercase; font-weight:500; color:#888; min-width:58px; padding-top:2px;">Tel</span>
            <span>+39 350 078 5990</span>
          </div>
          <div style="display:flex; gap:16px; font-size:13px;">
            <span style="font-size:9.5px; letter-spacing:0.1em; text-transform:uppercase; font-weight:500; color:#888; min-width:58px; padding-top:2px;">Orari</span>
            <span>Lun – Ven 09:00 – 19:00</span>
          </div>
        </div>
      </div>
      <form action="https://formspree.io/f/xwvwooow" method="POST" style="display:flex; flex-direction:column; gap:16px;">
        <input type="text" name="nome" placeholder="Il tuo nome" required style="background:transparent; border:none; border-bottom:1px solid rgba(0,0,0,0.2); padding:12px 0; font-size:13px; outline:none; font-family:inherit;" />
        <input type="email" name="email" placeholder="La tua email" required style="background:transparent; border:none; border-bottom:1px solid rgba(0,0,0,0.2); padding:12px 0; font-size:13px; outline:none; font-family:inherit;" />
        <textarea name="messaggio" placeholder="Raccontaci del tuo progetto" rows="4" style="background:transparent; border:none; border-bottom:1px solid rgba(0,0,0,0.2); padding:12px 0; font-size:13px; outline:none; font-family:inherit; resize:none;"></textarea>
        <button type="submit" style="align-self:flex-start; background:#0033ff; color:#fff; font-family:'Barlow Condensed',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:0.12em; font-size:13px; padding:14px 32px; border:none; border-radius:2px; cursor:pointer; margin-top:8px;">
          Invia
        </button>
      </form>
    </div>
  </section>

</BaseLayout>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  // --- Hero entrance (timeline staggered) ---
  const heroTitle = document.getElementById('hero-title')
  if (heroTitle) {
    const tl = gsap.timeline({ defaults: { ease: 'power4.out' } })
    tl.from('#hero-title',  { y: 80, opacity: 0, duration: 1.1, delay: 0.05 })
      .from('#hero-desc',   { y: 30, opacity: 0, duration: 0.9 }, '-=0.65')
      .from('#hero-cta',    { y: 20, opacity: 0, duration: 0.7 }, '-=0.6')
      .from('#hero-badge',  { scale: 0.75, opacity: 0, duration: 0.8, ease: 'back.out(2)' }, '-=0.7')
  }

  // --- Services stagger ---
  const serviceRows = gsap.utils.toArray<HTMLElement>('.gsap-service-row')
  if (serviceRows.length) {
    gsap.from(serviceRows, {
      scrollTrigger: { trigger: '#gsap-services', start: 'top 80%', once: true },
      y: 32, opacity: 0, duration: 0.7, stagger: 0.1, ease: 'power3.out'
    })
  }

  // --- Portfolio cards stagger ---
  const projCards = gsap.utils.toArray<HTMLElement>('.proj-card')
  if (projCards.length) {
    gsap.from(projCards, {
      scrollTrigger: { trigger: projCards[0], start: 'top 85%', once: true },
      y: 50, opacity: 0, duration: 0.8, stagger: 0.09, ease: 'power3.out'
    })
  }

  // --- Hero parallax ---
  if (heroTitle) {
    gsap.to('#hero-title', {
      scrollTrigger: {
        trigger: '#hero-section',
        start: 'top top',
        end: 'bottom top',
        scrub: 1.5
      },
      y: -70,
      ease: 'none'
    })
    gsap.to('#hero-desc', {
      scrollTrigger: {
        trigger: '#hero-section',
        start: 'top top',
        end: 'bottom top',
        scrub: 2
      },
      y: -40,
      ease: 'none'
    })
  }
</script>

<style>
  .proj-card {
    position: relative;
    overflow: hidden;
    background: #161616;
    text-decoration: none;
    display: block;
    aspect-ratio: 1/1;
  }
  .proj-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,51,255,0);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
    transition: background 0.3s;
  }
  .proj-card:hover .proj-overlay { background: rgba(0,51,255,0.7); }
  .proj-title {
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 20px;
    color: #fff;
    letter-spacing: 0.06em;
    margin: 0;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .proj-cat {
    font-size: 11px;
    color: rgba(255,255,255,0.7);
    margin: 4px 0 0;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .proj-card:hover .proj-title,
  .proj-card:hover .proj-cat { opacity: 1; }
  .logos-ticker {
    display: flex;
    align-items: center;
    gap: 64px;
    width: max-content;
    animation: logosTicker 25s linear infinite;
  }
  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes logosTicker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>