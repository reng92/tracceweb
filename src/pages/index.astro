        <textarea placeholder="Raccontaci del tuo progetto" rows="4" style="background:transparent; border:none; border-bottom:1px solid rgba(0,0,0,0.2); padding:12px 0; font-size:13px; outline:none; font-family:'DM Sans',sans-serif; color:#0a0a0a; resize:none; width:100%;"></textarea>
