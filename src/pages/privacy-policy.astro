---
import BaseLayout from "../layouts/BaseLayout.astro"
---
<BaseLayout title="Privacy Policy — Tracce Studio">

  <section class="ts-container" style="padding-top:80px; padding-bottom:40px;">
    <h1 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(48px,7vw,80px); line-height:0.92; color:#0a0a0a;">
      Privacy Policy
    </h1>
  </section>

  <section class="ts-container" style="padding-bottom:80px; max-width:800px;">
    <div style="background:#f8f8f8; padding:40px; border-radius:4px; margin-bottom:40px;">
      <p style="font-size:16px; line-height:1.6; color:#666;">
        Il contenuto della Privacy Policy sarà integrato tramite iubenda
      </p>
    </div>
  </section>

</BaseLayout>
