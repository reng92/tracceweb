---
import BaseLayout from "../layouts/BaseLayout.astro"
---
<BaseLayout title="Chi siamo — Tracce Studio">

  <section style="padding:80px 48px; display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
    <div>
      <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:24px;">— Chi siamo</p>
      <h1 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(48px,6vw,72px); line-height:0.92; color:#0a0a0a; margin-bottom:32px;">
        La web agency<br /><span style="color:#0033ff;">che ti posiziona</span>
      </h1>
      <p style="font-size:15px; line-height:1.8; color:#444; margin-bottom:20px;">
        Siamo Tracce, una web agency con sede in Campania. Dal 2021 aiutiamo aziende e professionisti a crescere nel mondo digitale con strategia, design e tecnologia.
      </p>
      <p style="font-size:15px; line-height:1.8; color:#444; margin-bottom:32px;">
        Distinguiti, fatti amare e soprattutto fa in modo che ti seguano. Ogni progetto nasce da un ascolto profondo delle tue esigenze e si trasforma in una soluzione digitale su misura.
      </p>
      <a href="/contatti" style="display:inline-block; background:#0033ff; color:#fff; font-family:'Barlow Condensed',sans-serif; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; font-size:13px; padding:14px 32px; border-radius:2px; text-decoration:none;">
        Lavora con noi
      </a>
    </div>
    <div style="background:#0a0a0a; border-radius:2px; padding:48px; display:flex; flex-direction:column; gap:32px;">
      <div>
        <div style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:56px; color:#0033ff; line-height:1;">2021</div>
        <div style="font-size:13px; color:#999; margin-top:4px;">Anno di fondazione</div>
      </div>
      <div style="border-top:1px solid #1a1a1a; padding-top:32px;">
        <div style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:56px; color:#0033ff; line-height:1;">50+</div>
        <div style="font-size:13px; color:#999; margin-top:4px;">Progetti completati</div>
      </div>
      <div style="border-top:1px solid #1a1a1a; padding-top:32px;">
        <div style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:56px; color:#0033ff; line-height:1;">100%</div>
        <div style="font-size:13px; color:#999; margin-top:4px;">Clienti soddisfatti</div>
      </div>
    </div>
  </section>

  <section style="padding:80px 48px; background:#0a0a0a;">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:40px;">— I nostri clienti</p>
    <div style="display:flex; gap:48px; align-items:center; flex-wrap:wrap;">
      <img src="/logos/chaletciro.png" alt="Chalet Ciro" style="height:32px; width:auto; filter:invert(1); opacity:0.6;" />
      <img src="/logos/casasurace.png" alt="Casa Surace" style="height:32px; width:auto; filter:invert(1); opacity:0.6;" />
      <img src="/logos/leangioine.png" alt="Le Angioine" style="height:32px; width:auto; filter:invert(1); opacity:0.6;" />
      <img src="/logos/fbibaits.png" alt="FBaits" style="height:32px; width:auto; filter:invert(1); opacity:0.6;" />
      <img src="/logos/dramee.svg" alt="Dramée" style="height:24px; width:auto; filter:invert(1); opacity:0.6;" />
      <img src="/logos/lustra.png" alt="Lustra" style="height:28px; width:auto; filter:invert(1); opacity:0.6;" />
      <img src="/logos/bitar.png" alt="Bitar" style="height:28px; width:auto; filter:invert(1); opacity:0.6;" />
    </div>
  </section>

</BaseLayout>