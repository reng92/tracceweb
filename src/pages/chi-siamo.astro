---
import BaseLayout from '../layouts/BaseLayout.astro'
import { client } from '../lib/sanity'
import { teamQuery } from '../lib/queries'
import { urlFor } from '../lib/sanity'

const team = await client.fetch(teamQuery).catch(() => [])

const staticTeam = [
  { name: 'Luigi Cartolano', role: 'Founder & Creative Director', bio: 'Appassionato di design e tecnologia, guida Tracce con visione strategica e attenzione maniacale ai dettagli.', photo: null },
]
---

<BaseLayout title="Chi siamo — Tracce Studio">

  <section style="padding:80px 48px 60px; border-bottom:1px solid rgba(0,0,0,0.08);">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:16px;">La nostra storia</p>
    <h1 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(48px,7vw,88px); line-height:1; color:#0a0a0a; margin:0;">
      Chi siamo
    </h1>
  </section>

  <section style="padding:80px 48px; display:grid; grid-template-columns:1fr 1fr; gap:80px; border-bottom:1px solid rgba(0,0,0,0.08);">
    <div>
      <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:20px;">La nostra missione</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:40px; line-height:1.05; color:#0a0a0a; margin:0 0 24px;">
        Trasformiamo idee in esperienze digitali memorabili
      </h2>
    </div>
    <div style="display:flex; flex-direction:column; gap:20px; padding-top:8px;">
      <p style="font-size:15px; line-height:1.8; color:#333; margin:0;">
        Tracce Studio è una web agency con sede in Campania. Lavoriamo con brand e imprenditori che vogliono distinguersi nel digitale con progetti autentici, strategici e belli da vedere.
      </p>
      <p style="font-size:15px; line-height:1.8; color:#333; margin:0;">
        Non facciamo siti standard. Ogni progetto nasce da un ascolto profondo: capiamo il business, il pubblico e gli obiettivi, poi costruiamo la soluzione più efficace.
      </p>
    </div>
  </section>

  <section style="padding:80px 48px;">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:48px;">Il team</p>
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:32px;">
      {(team.length > 0 ? team : staticTeam).map((member: any) => (
        <div>
          <div style="aspect-ratio:3/4; background:#e8e8e5; border-radius:2px; overflow:hidden; margin-bottom:16px;">
            {member.photo ? (
              <img src={urlFor(member.photo).width(400).url()} alt={member.name} style="width:100%; height:100%; object-fit:cover; display:block;" />
            ) : (
              <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center;">
                <span style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:48px; color:rgba(0,0,0,0.12); text-transform:uppercase;">
                  {member.name.split(' ').map((w: string) => w[0]).join('')}
                </span>
              </div>
            )}
          </div>
          <h3 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:20px; color:#0a0a0a; margin:0 0 4px;">{member.name}</h3>
          <p style="font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#0033ff; font-weight:500; margin:0 0 12px;">{member.role}</p>
          <p style="font-size:13px; line-height:1.7; color:#555; margin:0;">{member.bio}</p>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
