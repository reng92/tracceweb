---
import BaseLayout from '../layouts/BaseLayout.astro'
import { client } from '../lib/sanity'
import { teamQuery } from '../lib/queries'
import { urlFor } from '../lib/sanity'

const team = await client.fetch(teamQuery).catch(() => [])

const staticTeam = [
  { name: 'Luigi Cartolano', role: 'Founder & Creative Director', bio: 'Appassionato di design e tecnologia, guida Tracce con visione strategica e attenzione maniacale ai dettagli.', photo: null },
]
---

<BaseLayout title="Chi siamo — Tracce Studio">

  <section class="about-hero" style="border-bottom:1px solid rgba(0,0,0,0.08);">
    <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:16px;">La nostra storia</p>
    <h1 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:clamp(48px,7vw,88px); line-height:1; color:#0a0a0a; margin:0;">
      Chi siamo
    </h1>
  </section>

  <section class="about-grid" style="border-bottom:1px solid rgba(0,0,0,0.08);">
    <div>
      <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:20px;">La nostra missione</p>
      <h2 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:40px; line-height:1.05; color:#0a0a0a; margin:0 0 24px;">
        Trasformiamo idee in esperienze digitali memorabili
      </h2>
    </div>
    <div style="display:flex; flex-direction:column; gap:20px; padding-top:8px;">
      <p style="font-size:15px; line-height:1.8; color:#333; margin:0;">
        Tracce Studio è una web agency con sede in Campania. Lavoriamo con brand e imprenditori che vogliono distinguersi nel digitale con progetti autentici, strategici e belli da vedere.
      </p>
      <p style="font-size:15px; line-height:1.8; color:#333; margin:0;">
        Non facciamo siti standard. Ogni progetto nasce da un ascolto profondo: capiamo il business, il pubblico e gli obiettivi, poi costruiamo la soluzione più efficace.
      </p>
    </div>
  </section>

  <section class="about-stats-section">
    <div class="about-stats">
      <div class="stat-item">
        <div class="stat-value">
          <span class="stat-number" data-target="50">0</span><span class="stat-suffix">+</span>
        </div>
        <p class="stat-label">Progetti completati</p>
      </div>
      <div class="stat-item">
        <div class="stat-value">
          <span class="stat-number" data-target="30">0</span><span class="stat-suffix">+</span>
        </div>
        <p class="stat-label">Clienti felici</p>
      </div>
      <div class="stat-item">
        <div class="stat-value">
          <span class="stat-number" data-target="5">0</span><span class="stat-suffix">+</span>
        </div>
        <p class="stat-label">Anni nel digitale</p>
      </div>
    </div>
  </section>

  {false && (
    <section style="padding:80px 48px;">
      <p style="font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:#0033ff; font-weight:500; margin-bottom:48px;">Il team</p>
      <div class="about-values">
        {(team.length > 0 ? team : staticTeam).map((member: any) => (
          <div>
            <div style="aspect-ratio:3/4; background:#e8e8e5; border-radius:2px; overflow:hidden; margin-bottom:16px;">
              {member.photo ? (
                <img src={urlFor(member.photo).width(400).url()} alt={member.name} style="width:100%; height:100%; object-fit:cover; display:block;" />
              ) : (
                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center;">
                  <span style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:48px; color:rgba(0,0,0,0.12); text-transform:uppercase;">
                    {member.name.split(' ').map((w: string) => w[0]).join('')}
                  </span>
                </div>
              )}
            </div>
            <h3 style="font-family:'Barlow Condensed',sans-serif; font-weight:900; text-transform:uppercase; font-size:20px; color:#0a0a0a; margin:0 0 4px;">{member.name}</h3>
            <p style="font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:#0033ff; font-weight:500; margin:0 0 12px;">{member.role}</p>
            <p style="font-size:13px; line-height:1.7; color:#555; margin:0;">{member.bio}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <style>
    .about-hero {
      padding: 80px 48px 40px;
    }
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      padding: 60px 48px 80px;
    }
    .about-values {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 32px;
      padding: 60px 48px 80px;
    }
    .about-stats-section {
      padding: 60px 48px 80px;
      border-top: 1px solid rgba(0,0,0,0.08);
    }
    .about-stats {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 2px;
    }
    .stat-item {
      padding: 40px 32px;
      background: #0a0a0a;
    }
    .stat-value {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900;
      font-size: clamp(56px, 7vw, 88px);
      line-height: 1;
      color: #fff;
      margin-bottom: 12px;
    }
    .stat-suffix {
      color: #0033ff;
    }
    .stat-label {
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.4);
      margin: 0;
    }

    @media (max-width: 768px) {
      .about-hero {
        padding: 48px 20px 32px;
      }
      .about-grid {
        grid-template-columns: 1fr;
        gap: 32px;
        padding: 40px 20px 60px;
      }
      .about-values {
        grid-template-columns: 1fr;
        gap: 24px;
        padding: 40px 20px 60px;
      }
      .about-stats-section {
        padding: 40px 20px 60px;
      }
      .about-stats {
        grid-template-columns: 1fr;
      }
      .stat-item {
        padding: 28px 24px;
      }
    }
  </style>

</BaseLayout>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.about-hero')) return

    // Hero entrance
    gsap.from('.about-hero h1', { y: 60, opacity: 0, duration: 1.1, ease: 'power4.out', delay: 0.05 })

    // About grid fade
    gsap.from('.about-grid > div', {
      scrollTrigger: { trigger: '.about-grid', start: 'top 82%', once: true },
      y: 40, opacity: 0, duration: 0.9, stagger: 0.15, ease: 'power3.out'
    })

    // Stat items stagger
    gsap.from('.stat-item', {
      scrollTrigger: { trigger: '.about-stats', start: 'top 85%', once: true },
      y: 30, opacity: 0, duration: 0.8, stagger: 0.12, ease: 'power3.out'
    })

    // Animated counters
    document.querySelectorAll<HTMLElement>('.stat-number').forEach(el => {
      const target = parseInt(el.dataset.target || '0', 10)
      const obj = { val: 0 }
      ScrollTrigger.create({
        trigger: el,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          gsap.to(obj, {
            val: target,
            duration: 2,
            ease: 'power2.out',
            onUpdate: () => { el.textContent = Math.round(obj.val).toString() }
          })
        }
      })
    })
  })
</script>
