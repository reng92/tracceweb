---
const navLinks = [
  { label: "Home", href: "/" },
  { label: "Servizi", href: "/servizi" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "Chi siamo", href: "/chi-siamo" },
  { label: "Contatti", href: "/contatti" },
]

const currentPath = Astro.url.pathname
function isActive(href: string) {
  if (href === '/') return currentPath === '/'
  return currentPath.startsWith(href)
}
---

<header id="site-header" style="background:#f5f4f0; border-bottom:1px solid rgba(0,0,0,0.08); padding:0 48px; height:60px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100;">
  <a href="/" style="display:flex; align-items:center; flex-shrink:0;">
    <img src="/logos/tracce.svg" alt="Tracce Studio" style="height:26px; width:auto;" />
  </a>
  <nav id="nav-desktop" style="display:flex; gap:28px;">
    {navLinks.map(link => (
      <a href={link.href} class={isActive(link.href) ? 'nav-link nav-link--active' : 'nav-link'}>
        {link.label}
      </a>
    ))}
  </nav>
  <div style="display:flex; align-items:center; gap:16px;">
    <div class="nav-socials" style="display:flex; align-items:center; gap:12px;">
      <a href="https://www.instagram.com/tracceweb/" target="_blank" rel="noopener" aria-label="Instagram" class="nav-social-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
      <a href="https://www.facebook.com/tracceweb" target="_blank" rel="noopener" aria-label="Facebook" class="nav-social-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href="https://www.linkedin.com/company/tracce-web-agency/" target="_blank" rel="noopener" aria-label="LinkedIn" class="nav-social-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
      </a>
    </div>
    <a href="/contatti" id="nav-cta" style="background:#0033ff; color:#fff; font-size:11px; font-weight:500; letter-spacing:0.08em; text-transform:uppercase; padding:9px 20px; border-radius:2px; text-decoration:none;">
      Inizia il progetto
    </a>
    <button id="hamburger" aria-label="Menu" style="display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:4px;">
      <span class="bar" style="width:22px; height:2px; background:#0a0a0a; display:block; transition:all 0.3s;"></span>
      <span class="bar" style="width:22px; height:2px; background:#0a0a0a; display:block; transition:all 0.3s;"></span>
      <span class="bar" style="width:22px; height:2px; background:#0a0a0a; display:block; transition:all 0.3s;"></span>
    </button>
  </div>
</header>

<div id="mobile-menu" style="display:none; position:fixed; top:60px; left:0; right:0; background:#f5f4f0; border-bottom:1px solid rgba(0,0,0,0.08); z-index:99; padding:24px 20px; flex-direction:column; gap:0;">
  {navLinks.map(link => (
    <a href={link.href} style={`font-size:13px; font-weight:500; letter-spacing:0.1em; text-transform:uppercase; color:${isActive(link.href) ? '#0033ff' : '#0a0a0a'}; text-decoration:none; padding:16px 0; border-bottom:1px solid rgba(0,0,0,0.06); display:block;`}>
      {link.label}
    </a>
  ))}
  <a href="/contatti" style="margin-top:20px; display:block; background:#0033ff; color:#fff; font-size:12px; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; padding:14px 24px; border-radius:2px; text-decoration:none; text-align:center;">
    Inizia il progetto
  </a>
</div>

<style>
  .nav-link {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #0a0a0a;
    text-decoration: none;
    position: relative;
    padding-bottom: 2px;
  }
  .nav-link:hover {
    color: #0033ff;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 1px;
    background: #0033ff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  .nav-link--active {
    color: #0033ff;
  }
  .nav-link--active::after {
    transform: scaleX(1);
  }
  .nav-social-link {
    color: #0a0a0a;
    opacity: 0.45;
    transition: opacity 0.2s;
    display: flex;
    align-items: center;
  }
  .nav-social-link:hover {
    opacity: 1;
  }
  @media (max-width: 768px) {
    #nav-desktop { display: none !important; }
    #nav-cta { display: none !important; }
    .nav-socials { display: none !important; }
    #hamburger { display: flex !important; }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const hamburger = document.getElementById('hamburger')
    const mobileMenu = document.getElementById('mobile-menu')
    if (!hamburger || !mobileMenu) return

    // Replace with a fresh clone to strip any stale listeners from previous navigations
    const btn = hamburger.cloneNode(true) as HTMLElement
    hamburger.parentNode!.replaceChild(btn, hamburger)

    let open = false

    btn.addEventListener('click', () => {
      open = !open
      mobileMenu.style.display = open ? 'flex' : 'none'
      const bars = btn.querySelectorAll<HTMLElement>('.bar')
      if (open) {
        bars[0].style.transform = 'rotate(45deg) translate(5px, 5px)'
        bars[1].style.opacity = '0'
        bars[2].style.transform = 'rotate(-45deg) translate(5px, -5px)'
      } else {
        bars[0].style.transform = ''
        bars[1].style.opacity = '1'
        bars[2].style.transform = ''
      }
    })

    mobileMenu.querySelectorAll<HTMLElement>('a').forEach(link => {
      link.addEventListener('click', () => {
        open = false
        mobileMenu.style.display = 'none'
        const bars = btn.querySelectorAll<HTMLElement>('.bar')
        bars[0].style.transform = ''
        bars[1].style.opacity = '1'
        bars[2].style.transform = ''
      })
    })
  })
</script>