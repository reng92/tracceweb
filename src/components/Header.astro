---
const navLinks = [
  { label: "Home", href: "/" },
  { label: "Servizi", href: "/servizi" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "Chi siamo", href: "/chi-siamo" },
  { label: "Contatti", href: "/contatti" },
]
---
<header style="background:#f5f4f0; border-bottom:1px solid rgba(0,0,0,0.08); padding:0 48px; height:60px; display:flex; align-items:center; justify-content:space-between; position:sticky; top:0; z-index:100;">
  <a href="/" style="font-family:'Barlow Condensed',sans-serif; font-weight:900; font-size:22px; letter-spacing:0.1em; text-transform:uppercase; color:#0a0a0a; text-decoration:none;">
    TRACCE
  </a>
  <nav style="display:flex; gap:28px;">
    {navLinks.map((link) => (
      <a href={link.href} style="font-size:11px; font-weight:500; letter-spacing:0.1em; text-transform:uppercase; color:#0a0a0a; text-decoration:none;">
        {link.label}
      </a>
    ))}
  </nav>
  <a href="/contatti" style="background:#0033ff; color:#fff; font-size:11px; font-weight:500; letter-spacing:0.08em; text-transform:uppercase; padding:9px 20px; border-radius:2px; text-decoration:none;">
    Inizia il progetto
  </a>
</header>