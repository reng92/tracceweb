---
const navLinks = [
  { label: "Home", href: "/" },
  { label: "Servizi", href: "/servizi" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "Chi siamo", href: "/chi-siamo" },
  { label: "Contatti", href: "/contatti" },
]
---
<footer style="background:#0a0a0a; color:#fff; padding:52px 48px 28px;">
  <div class="ts-footer-grid" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:48px; margin-bottom:40px;">
    <div>
      <img src="/logos/tracce.svg" alt="Tracce Studio" style="height:26px; filter:invert(1); display:block; margin-bottom:16px;" />
      <div style="font-size:12px; line-height:1.9; color:#666;">
        <div style="font-size:9px; letter-spacing:0.12em; text-transform:uppercase; color:#444; font-weight:500; margin-bottom:4px;">Sede operativa</div>
        Via Alcide de Gasperi, 33<br />81055 – Santa Maria Capua Vetere (CE)<br />
        <details style="margin-top:10px; cursor:pointer;">
          <summary style="font-size:9px; letter-spacing:0.12em; text-transform:uppercase; color:#444; font-weight:500; list-style:none; display:flex; align-items:center; gap:6px; cursor:pointer; user-select:none;">
            <span>Sede legale</span>
            <svg class="ts-accordion-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M2 3.5l3 3 3-3"/></svg>
          </summary>
          <div style="margin-top:6px; padding-left:0; color:#555;">
            Luigi Cartolano<br />Via Mezzacapo 192<br />84036 – Sala Consilina (SA)
          </div>
        </details>
        <div style="margin-top:10px;">P.IVA: IT06207980654</div>
        info@traccestudio.it<br />+39 350 078 5990
      </div>
      <style>
        details[open] .ts-accordion-icon { transform: rotate(180deg); }
        .ts-accordion-icon { transition: transform 0.2s; }
        details summary::-webkit-details-marker { display: none; }
      </style>
    </div>
    <div>
      <div style="font-size:9.5px; letter-spacing:0.14em; text-transform:uppercase; color:#444; font-weight:500; margin-bottom:16px;">Navigazione</div>
      {navLinks.map((link) => (
        <a href={link.href} style="display:block; font-size:12px; color:#999; line-height:2.1; text-decoration:none;">{link.label}</a>
      ))}
    </div>
    <div>
      <div style="font-size:9.5px; letter-spacing:0.14em; text-transform:uppercase; color:#444; font-weight:500; margin-bottom:16px;">Legale</div>
      <a href="/privacy-policy" style="display:block; font-size:12px; color:#999; line-height:2.1; text-decoration:none;">Privacy Policy</a>
      <a href="/cookie-policy" style="display:block; font-size:12px; color:#999; line-height:2.1; text-decoration:none;">Cookie Policy</a>
      <button onclick="window.showCookieBanner()" style="background:none; border:none; padding:0; display:block; font-size:12px; line-height:2.1; color:rgba(255,255,255,0.5); cursor:pointer; text-align:left; font-family:inherit; transition:color 0.2s;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='rgba(255,255,255,0.5)'">
        Preferenze cookie
      </button>
      <div style="display:flex; gap:14px; margin-top:20px;">
        <a href="https://www.instagram.com/tracceweb/" target="_blank" rel="noopener" aria-label="Instagram" style="color:#555; transition:color 0.2s; display:flex;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#555'">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://www.facebook.com/tracceweb" target="_blank" rel="noopener" aria-label="Facebook" style="color:#555; transition:color 0.2s; display:flex;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#555'">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/tracce-web-agency/" target="_blank" rel="noopener" aria-label="LinkedIn" style="color:#555; transition:color 0.2s; display:flex;" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#555'">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
      </div>
    </div>
  </div>
  <div style="border-top:1px solid #1a1a1a; padding-top:24px; display:flex; justify-content:space-between; font-size:11px; color:#444; flex-wrap:wrap; gap:8px;">
    <span>© {new Date().getFullYear()} Tracce Studio — Web Agency</span>
    <span>Website designed by Tracce</span>
  </div>
</footer>