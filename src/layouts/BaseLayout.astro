---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'
import '@fontsource/barlow-condensed/700.css'
import '@fontsource/barlow-condensed/800.css'
import '@fontsource/barlow-condensed/900.css'
import '@fontsource/dm-sans/400.css'
import '@fontsource/dm-sans/500.css'

interface Props {
  title?: string
  description?: string
  pageSchema?: Record<string, unknown>
}

const {
  title = 'Tracce Studio — Web Agency Campania',
  description = 'Siamo una web agency con sede in Campania.',
  pageSchema
} = Astro.props

const canonicalURL = new URL(Astro.url.pathname, 'https://traccestudio.it').href
---
<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="shortcut icon" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0033ff" />
  <!-- Google Search Console — sostituire con il codice del proprio account -->
  <!-- <meta name="google-site-verification" content="IL_TUO_CODICE_QUI" /> -->

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://traccestudio.it/tracce_logo_1200x600.png" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="it_IT" />
  <meta property="og:site_name" content="Tracce Studio" />
  <meta property="og:image:alt" content="Tracce Studio — Web Agency Campania" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://traccestudio.it/tracce_logo_1200x600.png" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <!-- Google Analytics 4 — caricato solo con consenso analitici -->
  <script is:inline>
    (function () {
      function loadGA() {
        if (document.getElementById('ga-script')) return
        var s = document.createElement('script')
        s.id = 'ga-script'
        s.async = true
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-FMZYV1EVP3'
        document.head.appendChild(s)
        window.dataLayer = window.dataLayer || []
        function gtag() { window.dataLayer.push(arguments) }
        window.gtag = gtag
        gtag('js', new Date())
        gtag('config', 'G-FMZYV1EVP3')
      }
      window.__loadAnalytics = loadGA
      try {
        var c = JSON.parse(localStorage.getItem('tracce_cookie_consent') || 'null')
        if (c && c.analitici) loadGA()
      } catch (e) {}
    })()
  </script>
  <ClientRouter />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Tracce Studio",
    "description": "Web agency in Campania specializzata in branding, web design e sviluppo web.",
    "url": "https://traccestudio.it",
    "logo": "https://traccestudio.it/logos/tracce.svg",
    "image": "https://traccestudio.it/tracce_logo_1200x600.png",
    "telephone": "+393500785990",
    "email": "info@traccestudio.it",
    "address": {
      "@type": "PostalAddress",
      "addressRegion": "Campania",
      "addressCountry": "IT"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "09:00",
        "closes": "19:00"
      }
    ],
    "serviceType": ["Branding","Web Design","Web Development","E-commerce","SEO"],
    "areaServed": {
      "@type": "State",
      "name": "Campania"
    },
    "sameAs": [
      "https://instagram.com/traccestudio",
      "https://linkedin.com/company/traccestudio"
    ]
  })} />
  {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
</head>
<body>
  <div id="scroll-progress" style="position:fixed;top:0;left:0;height:2px;background:#0033ff;width:0%;z-index:10000;pointer-events:none;will-change:width;transform-origin:left;"></div>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <!-- WHATSAPP -->
  <a href="https://wa.me/393500785990" target="_blank" rel="noopener" aria-label="Contattaci su WhatsApp" style="position:fixed;bottom:28px;left:28px;width:48px;height:48px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;z-index:998;box-shadow:0 4px 20px rgba(37,211,102,0.45);text-decoration:none;transition:transform 0.2s,box-shadow 0.2s;" onmouseover="this.style.transform='scale(1.1)';this.style.boxShadow='0 6px 28px rgba(37,211,102,0.6)'" onmouseout="this.style.transform='scale(1)';this.style.boxShadow='0 4px 20px rgba(37,211,102,0.45)'">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </a>

  <!-- BACK TO TOP -->
  <button id="back-to-top" aria-label="Torna su" style="position:fixed;bottom:28px;right:28px;width:44px;height:44px;background:#0a0a0a;color:#fff;border:none;border-radius:2px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:998;opacity:0;pointer-events:none;transition:opacity 0.3s,transform 0.3s;transform:translateY(8px);" class="btt-btn">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M8 12V4M4 8l4-4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <script is:inline>
    (function () {
      var btn = document.getElementById('back-to-top')
      if (!btn) return
      // Click: si ri-aggancia ad ogni navigazione (btn è un nuovo elemento)
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' })
      })
      // Scroll: un solo listener per tutta la sessione
      if (!window.__btScrollInit) {
        window.__btScrollInit = true
        window.addEventListener('scroll', function () {
          var b = document.getElementById('back-to-top')
          if (!b) return
          var show = window.scrollY > 400
          b.style.opacity = show ? '1' : '0'
          b.style.pointerEvents = show ? 'auto' : 'none'
          b.style.transform = show ? 'translateY(0)' : 'translateY(8px)'
        }, { passive: true })
      }
    })()
  </script>

  <!-- GSAP GLOBAL -->
  <script>
    import { gsap } from 'gsap'
    import { ScrollTrigger } from 'gsap/ScrollTrigger'
    gsap.registerPlugin(ScrollTrigger)

    // Progress bar — un solo listener per tutta la sessione
    if (!(window as any).__progressInit) {
      ;(window as any).__progressInit = true
      window.addEventListener('scroll', () => {
        const bar = document.getElementById('scroll-progress')
        if (!bar) return
        const max = document.documentElement.scrollHeight - window.innerHeight
        gsap.set(bar, { width: (max > 0 ? (window.scrollY / max) * 100 : 0) + '%' })
      }, { passive: true })
    }

    function initGlobalAnimations() {
      // Pulisce i ScrollTrigger della pagina precedente
      ScrollTrigger.getAll().forEach(st => st.kill())

      // Fade + slide-up globale
      gsap.utils.toArray<HTMLElement>('[data-gsap="fade"]').forEach(el => {
        gsap.from(el, {
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
          y: 48, opacity: 0, duration: 0.9, ease: 'power3.out'
        })
      })

      // Magnetic buttons
      document.querySelectorAll<HTMLElement>('[data-gsap="magnetic"]').forEach(btn => {
        btn.addEventListener('mousemove', (e: MouseEvent) => {
          const rect = btn.getBoundingClientRect()
          const dx = (e.clientX - (rect.left + rect.width / 2)) * 0.38
          const dy = (e.clientY - (rect.top + rect.height / 2)) * 0.38
          gsap.to(btn, { x: dx, y: dy, duration: 0.3, ease: 'power2.out' })
        })
        btn.addEventListener('mouseleave', () => {
          gsap.to(btn, { x: 0, y: 0, duration: 0.65, ease: 'elastic.out(1,0.4)' })
        })
      })
    }

    document.addEventListener('astro:page-load', initGlobalAnimations)
  </script>

  <!-- COOKIE PANEL -->
  <div id="cookie-panel" aria-label="Preferenze cookie" role="dialog" aria-modal="true">
    <div class="cp-header">
      <p class="cp-label">Cookie</p>
      <p class="cp-desc">
        Utilizziamo cookie tecnici e, previo consenso, cookie analitici (Google Analytics 4).
        <a href="/cookie-policy">Cookie Policy</a>.
      </p>
    </div>

    <!-- Vista compatta (default) -->
    <div class="cp-compact-actions" id="cp-compact-actions">
      <button id="cookie-accept-all" class="cp-btn cp-btn--primary">Accetta tutti</button>
      <button id="cookie-necessary" class="cp-btn cp-btn--ghost">Solo necessari</button>
      <button id="cookie-customize" class="cp-btn cp-btn--text">Personalizza →</button>
    </div>

    <!-- Vista dettagliata (espansa su "Personalizza") -->
    <div id="cp-detail" style="display:none;">
      <div class="cp-categories">

        <div class="cp-row">
          <div class="cp-row-info">
            <span class="cp-cat-name">Necessari</span>
            <p class="cp-cat-desc">Indispensabili per il funzionamento del sito.</p>
          </div>
          <span class="cp-always-on">Sempre attivi</span>
        </div>

        <div class="cp-row">
          <div class="cp-row-info">
            <span class="cp-cat-name">Funzionali</span>
            <p class="cp-cat-desc">Memorizzano preferenze di navigazione.</p>
          </div>
          <label class="cp-toggle">
            <input type="checkbox" id="toggle-funzionali" />
            <span class="cp-track"><span class="cp-thumb"></span></span>
          </label>
        </div>

        <div class="cp-row">
          <div class="cp-row-info">
            <span class="cp-cat-name">Analitici</span>
            <p class="cp-cat-desc">Dati anonimi sulle visite (Google Analytics 4).</p>
          </div>
          <label class="cp-toggle">
            <input type="checkbox" id="toggle-analitici" />
            <span class="cp-track"><span class="cp-thumb"></span></span>
          </label>
        </div>

        <div class="cp-row cp-row--last">
          <div class="cp-row-info">
            <span class="cp-cat-name">Profilazione</span>
            <p class="cp-cat-desc">Pubblicità pertinente ai tuoi interessi.</p>
          </div>
          <label class="cp-toggle">
            <input type="checkbox" id="toggle-profilazione" />
            <span class="cp-track"><span class="cp-thumb"></span></span>
          </label>
        </div>

      </div>
      <div class="cp-actions">
        <button id="cookie-save" class="cp-btn cp-btn--primary">Salva preferenze</button>
      </div>
    </div>
  </div>

  <style>
    #cookie-panel {
      position: fixed;
      bottom: 24px;
      right: 24px;
      width: 380px;
      max-height: calc(100vh - 48px);
      overflow-y: auto;
      background: #0a0a0a;
      color: #fff;
      border-radius: 4px;
      z-index: 9999;
      box-shadow: 0 16px 60px rgba(0,0,0,0.4);
      font-family: 'DM Sans', sans-serif;
      transform: translateY(calc(100% + 32px));
      opacity: 0;
      transition: transform 0.4s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease;
      pointer-events: none;
    }
    #cookie-panel.cp-visible {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .cp-header {
      padding: 16px 20px 0;
    }
    .cp-label {
      font-size: 9px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: #0033ff;
      font-weight: 600;
      margin: 0 0 6px;
    }
    .cp-desc {
      font-size: 11px;
      line-height: 1.55;
      color: rgba(255,255,255,0.45);
      margin: 0;
    }
    .cp-desc a {
      color: #0033ff;
      text-decoration: underline;
    }

    /* Azioni compatte */
    .cp-compact-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 20px 16px;
      flex-wrap: wrap;
    }
    .cp-compact-actions .cp-btn--primary { flex: 1; }
    .cp-compact-actions .cp-btn--ghost   { flex: 1; }

    .cp-categories {
      padding: 16px 24px 0;
    }
    .cp-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      padding: 14px 0;
      border-top: 1px solid rgba(255,255,255,0.07);
    }
    .cp-row--last {
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .cp-row-info {
      flex: 1;
    }
    .cp-cat-name {
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      display: block;
      margin-bottom: 3px;
    }
    .cp-cat-desc {
      font-size: 11px;
      line-height: 1.5;
      color: rgba(255,255,255,0.4);
      margin: 0;
    }
    .cp-always-on {
      font-size: 9px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.3);
      white-space: nowrap;
      padding-top: 2px;
      flex-shrink: 0;
    }

    /* Toggle */
    .cp-toggle {
      flex-shrink: 0;
      cursor: pointer;
      display: block;
      padding-top: 2px;
    }
    .cp-toggle input {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }
    .cp-track {
      display: block;
      width: 40px;
      height: 22px;
      background: rgba(255,255,255,0.12);
      border-radius: 11px;
      position: relative;
      transition: background 0.25s ease;
    }
    .cp-thumb {
      position: absolute;
      top: 3px;
      left: 3px;
      width: 16px;
      height: 16px;
      background: rgba(255,255,255,0.4);
      border-radius: 50%;
      transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), background 0.25s ease;
    }
    .cp-toggle input:checked + .cp-track {
      background: #0033ff;
    }
    .cp-toggle input:checked + .cp-track .cp-thumb {
      transform: translateX(18px);
      background: #fff;
    }

    /* Buttons */
    .cp-actions {
      padding: 12px 20px 16px;
    }
    .cp-btn {
      width: 100%;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700;
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      border-radius: 2px;
      cursor: pointer;
      padding: 10px 16px;
      border: none;
      transition: opacity 0.2s;
    }
    .cp-btn:hover { opacity: 0.85; }
    .cp-btn--primary {
      background: #0033ff;
      color: #fff;
    }
    .cp-btn--ghost {
      background: transparent;
      color: rgba(255,255,255,0.7);
      border: 1px solid rgba(255,255,255,0.15) !important;
    }
    .cp-btn--text {
      background: transparent;
      color: rgba(255,255,255,0.35);
      font-size: 10px;
      padding: 4px 6px;
      width: auto;
      white-space: nowrap;
    }

    @media (max-width: 600px) {
      .btt-btn {
        bottom: 16px !important;
        right: 16px !important;
      }
      #cookie-panel {
        right: 0;
        left: 0;
        bottom: 0;
        width: 100%;
        border-radius: 12px 12px 0 0;
        max-height: 75vh;
      }
      .cp-header { padding: 14px 16px 0; }
      .cp-desc { font-size: 10.5px; }
      .cp-compact-actions { padding: 10px 16px 14px; gap: 6px; }
      .cp-categories { padding: 8px 16px 0; }
      .cp-row { padding: 9px 0; }
      .cp-cat-desc { display: none; }
      .cp-actions { padding: 10px 16px 14px; }
    }
  </style>

  <script is:inline>
    (function () {
      var panel = document.getElementById('cookie-panel');
      var compactActions = document.getElementById('cp-compact-actions');
      var detail = document.getElementById('cp-detail');

      function getConsent() {
        try { return JSON.parse(localStorage.getItem('tracce_cookie_consent') || 'null'); } catch { return null; }
      }
      function saveConsent(prefs) {
        localStorage.setItem('tracce_cookie_consent', JSON.stringify(prefs));
      }
      function hideBanner() { panel.classList.remove('cp-visible'); }
      function showBanner()  { panel.classList.add('cp-visible'); }
      window.showCookieBanner = showBanner;

      var saved = getConsent();
      if (saved && typeof saved === 'object') {
        ['funzionali', 'analitici', 'profilazione'].forEach(function(cat) {
          var el = document.getElementById('toggle-' + cat);
          if (el) el.checked = !!saved[cat];
        });
      }
      if (!saved) setTimeout(showBanner, 300);

      document.getElementById('cookie-customize').addEventListener('click', function () {
        compactActions.style.display = 'none';
        detail.style.display = 'block';
      });

      document.getElementById('cookie-save').addEventListener('click', function () {
        var analitici = document.getElementById('toggle-analitici').checked;
        saveConsent({
          necessari: true,
          funzionali: document.getElementById('toggle-funzionali').checked,
          analitici:  analitici,
          profilazione: document.getElementById('toggle-profilazione').checked,
        });
        if (analitici && typeof window.__loadAnalytics === 'function') window.__loadAnalytics();
        hideBanner();
      });

      document.getElementById('cookie-accept-all').addEventListener('click', function () {
        ['funzionali', 'analitici', 'profilazione'].forEach(function(cat) {
          var el = document.getElementById('toggle-' + cat);
          if (el) el.checked = true;
        });
        saveConsent({ necessari: true, funzionali: true, analitici: true, profilazione: true });
        if (typeof window.__loadAnalytics === 'function') window.__loadAnalytics();
        hideBanner();
      });

      document.getElementById('cookie-necessary').addEventListener('click', function () {
        ['funzionali', 'analitici', 'profilazione'].forEach(function(cat) {
          var el = document.getElementById('toggle-' + cat);
          if (el) el.checked = false;
        });
        saveConsent({ necessari: true, funzionali: false, analitici: false, profilazione: false });
        hideBanner();
      });
    })();
  </script>
</body>
</html>